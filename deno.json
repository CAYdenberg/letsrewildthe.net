{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build:app": "vite build",
    "build:content": "deno run -A build.ts",
    "build": "deno task build:app && deno task build:content",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": ["fresh", "recommended"]
    }
  },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "@planigale/querystring": "jsr:@planigale/querystring@^0.1.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@zod/zod": "jsr:@zod/zod@^4.4.3",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@lps/volcano": "jsr:@lps/volcano@^0.0.6",
    "lucide-preact": "npm:lucide-preact@0.525.0",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "ptera": "https://deno.land/x/ptera@v1.0.2/mod.ts",
    "ptera/": "https://deno.land/x/ptera@v1.0.2/"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  }
}
